---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Pomodoro — Focus gently"
  description="A calm, offline-friendly to-do list and Pomodoro timer."
>
  <main class="app-shell">
    <div class="wordmark">pom<span>.</span></div>
    <section class="welcome-card">
      <p class="eyebrow">A quieter way to study</p>
      <h1>Focus gently.<br />Finish steadily.</h1>
      <p>Your focused study space is taking shape.</p>
    </section>
  </main>
</Layout>

